{
  "global_seed": 1980,
  "initialization_seeds": [1980, 1981, 1982],
  "substitution_margin_pp": 3.0,
  "substitution_metrics": ["accuracy", "obstructed_recall"],
  "fold_assignments": "results/full_search/fold_assignments.csv",
  "architectures": ["ResNet101V2", "EfficientNetB3", "MobileNet", "ResNet50", "EfficientNetB4"],
  "configurations": ["D"],
  "configuration_specs": {
    "D": {"backbone_trainable": true, "optimizer": "adam", "learning_rate": 0.001},
    "A": {"backbone_trainable": false, "optimizer": "rmsprop", "learning_rate": 0.001}
  },
  "validation_fraction": 0.2,
  "validation_seed": 1980,
  "head": {"units": 128, "activation": "relu", "kernel_initializer": "he_uniform"},
  "epochs": 50,
  "batch_size": 16,
  "reduce_lr": {"monitor": "val_accuracy", "factor": 0.5, "patience": 2, "min_lr": 0.00001},
  "early_stopping": {"monitor": "val_loss", "patience": 10, "restore_best_weights": true},
  "benchmark": {"warmup": 10, "repetitions": 100},
  "fixed_features": {
    "enabled": true,
    "config": "configs/article_selected_models_10fold.json",
    "results": "results/full_search"
  },
  "cpu_threads": 2,
  "verbose": 2
}
